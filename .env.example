# ===================================================================
# Sentinel Platform - Production Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR SECURE CREDENTIALS.
# NEVER COMMIT .env TO GIT VERSION CONTROL.
# ===================================================================

# Database Configuration
POSTGRES_DB=sentinel_db
POSTGRES_USER=sentinel_admin
POSTGRES_PASSWORD=CHANGE_ME_TO_A_SECURE_STRONG_POSTGRES_PASSWORD_32CHARS!
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis Cache Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_TO_A_SECURE_REDIS_PASSWORD_32CHARS!

# Security & Authentication
JWT_SECRET=CHANGE_ME_TO_A_VERY_LONG_SECURE_256BIT_HMAC_SHA_SECRET_KEY_SENTINEL_2026!
SENTINEL_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://sentinel.enterprise.com

# Kafka Bus Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Initial Admin Bootstrap (Optional)
SENTINEL_BOOTSTRAP_ADMIN_EMAIL=admin@sentinel.com
SENTINEL_BOOTSTRAP_ADMIN_USERNAME=admin
SENTINEL_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_SECURE_ADMIN_PASS_2026!
